# Public site URL — used for canonical links, OG tags, sitemap, robots.
# Falls back to the live Vercel URL if unset.
NEXT_PUBLIC_SITE_URL=https://zstudio.vercel.app

# Contact form (app/api/contact/route.ts) — sends via Resend (https://resend.com).
# Without these two, the form returns a 500 and shows the error state.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Optional — must be a verified sender/domain in Resend. Defaults to Resend's
# shared onboarding address, which works without domain verification.
CONTACT_FROM_EMAIL=
